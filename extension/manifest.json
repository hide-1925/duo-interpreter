{
  "manifest_version": 3,
  "name": "Duo Interpreter",
  "short_name": "Duo",
  "version": "1.4.46",
  "version_name": "1.4.46 HTML v1.49.35 と対。読み上げに OpenRouter（Gemini TTS など）と Groq（Orpheus・英語／アラビア語）を足す",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "description": "現在のタブへ字幕を直接重ねる、多言語双方向通訳・文字起こしツール",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.mistral.ai/*",
    "https://api.together.xyz/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.aivis-project.com/*",
    "https://hub.aivis-project.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.tts.quest/*",
    "https://static.tts.quest/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://hide-1925.github.io/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Duo Interpreter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "popup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://* wss://* http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; media-src 'self' data: blob: https://*; style-src 'self' 'unsafe-inline'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "conference-adapters/mic-provenance.js",
        "conference-adapters/teams.js",
        "audio-bridge/target.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "audio-bridge/target-content.js",
        "conference-adapters/teams-speakers.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
